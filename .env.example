# Supabase → Project Settings → Database → Connection string
# URL "Transaction" (porta 6543, com ?pgbouncer=true) — usada em runtime pela aplicação
DATABASE_URL="postgresql://postgres.xxxxx:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL "Session"/direta (porta 5432, sem pgbouncer) — usada só para migrations
DIRECT_URL="postgresql://postgres.xxxxx:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Gere um valor novo com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="troque-por-um-valor-gerado"

# Em produção, use a URL pública do domínio da Vercel (ex: https://seu-projeto.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
